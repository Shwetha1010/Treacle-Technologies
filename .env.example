# Database Configurations
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_assistant

# Write access credentials (for schema creation and importing data)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=admin_password

# Read-only agent credentials (for running AI orchestrator queries)
DB_AGENT_USER=soc_agent
DB_AGENT_PASSWORD=soc_agent_read_only_pass_987

# Security and JWT Configurations
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production_123!
JWT_ALGORITHM=HS256

# LLM Provider Key (Groq)
GROQ_API_KEY=your_groq_api_key_here
